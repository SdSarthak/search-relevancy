# Copy to .env and adjust. Every value below is optional - the defaults in
# config/config.py are used when a variable is absent. .env is gitignored.

# --- Flask -----------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# 1/true/yes/on enable the debug server. Never enable it in production.
FLASK_DEBUG=0

# --- Model -----------------------------------------------------------------
# Any sentence-transformers model. Changing it means rebuilding the index.
SBERT_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Index -----------------------------------------------------------------
# auto | annoy | exact  (auto uses annoy when it is installed)
INDEX_BACKEND=auto
ANNOY_NUM_TREES=10
ANNOY_METRIC=angular

# --- Search ----------------------------------------------------------------
DEFAULT_NUM_RESULTS=10
MAX_NUM_RESULTS=50
# Characters of article body returned per hit; 0 returns the whole body.
SNIPPET_CHARS=400

# --- Preprocessing ---------------------------------------------------------
SPACY_MODEL=en_core_web_sm
MIN_TEXT_LENGTH=10
REMOVE_STOPWORDS=1
LOWERCASE=1
REMOVE_PUNCTUATION=0

# --- Paths (override to keep data and models outside the repo) -------------
# DATA_DIR=/var/lib/search-relevancy/data
# MODEL_DIR=/var/lib/search-relevancy/models

# --- AWS (only needed if you sync artefacts to S3) --------------------------
AWS_REGION=us-east-1
AWS_BUCKET=REPLACE_WITH_YOUR_BUCKET
# Prefer an IAM instance role. If you must use static keys, put them here and
# keep this file out of version control.
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME
